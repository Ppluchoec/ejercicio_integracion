  <diagram id="c4-dynamic-corte-propiedad" name="C4 Dynamic - Corte de Propiedad Multicore">
    <mxGraphModel dx="3671" dy="2394" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="a_title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" value="Diagrama C4 Dynamic — Corte de propiedad multicore" vertex="1">
          <mxGeometry height="60" width="2000" x="-130" y="-260" as="geometry" />
        </mxCell>
        <mxCell id="a_note" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#666666;whiteSpace=wrap;" value="Contexto: se activa cuando se decide transferir la propiedad de una cuenta de un core a otro (migración gradual, sección 16). No sustituye una transacción atómica: cada paso queda registrado para permitir recuperación ante fallos." vertex="1">
          <mxGeometry height="50" width="1200" x="280" y="-170" as="geometry" />
        </mxCell>
        <mxCell id="a_proc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1a1a1a;fontSize=12;fontStyle=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Proceso de Corte&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Proceso operado por el equipo de migración]&lt;/i&gt;" vertex="1">
          <mxGeometry height="100" width="280" x="760" y="40" as="geometry" />
        </mxCell>
        <mxCell id="a_origen" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Core Origen&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Core Bancario Tradicional o Digital, según dirección de la migración]&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="300" x="60" y="40" as="geometry" />
        </mxCell>
        <mxCell id="a_destino" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Core Destino&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Core Bancario Digital o Tradicional, según dirección de la migración]&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="300" x="1460" y="40" as="geometry" />
        </mxCell>
        <mxCell id="a_ownreg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Registro de Propiedad de Cuentas&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: KV replicado]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Almacena propietario, versión y estado por cuenta; también funciona como registro durable de migración (secciones 7.1 y 15)" vertex="1">
          <mxGeometry height="170" width="280" x="760" y="340" as="geometry" />
        </mxCell>
        <mxCell id="a_eventbus" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Event Bus&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: Apache Kafka]&lt;/i&gt;" vertex="1">
          <mxGeometry height="100" width="260" x="370" y="680" as="geometry" />
        </mxCell>
        <mxCell id="a_readmodel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Vista Agregada de Cliente&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor: Read Model]&lt;/i&gt;" vertex="1">
          <mxGeometry height="100" width="260" x="810" y="680" as="geometry" />
        </mxCell>
        <mxCell id="a_failclosed" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#666666;whiteSpace=wrap;" value="Contingencia: si el Registro de Propiedad de Cuentas no está disponible en cualquiera de estos pasos, la operación se rechaza (fail-closed); no se asume un estado de propiedad. Si falla el paso 5 (habilitación local), el Proceso de Corte reconsulta este registro para verificar el estado real antes de reintentar o revertir (recuperación de un corte interrumpido, 16.1)." vertex="1">
          <mxGeometry height="170" width="380" x="1120" y="340" as="geometry" />
        </mxCell>
        <mxCell id="a_e1" edge="1" parent="1" source="a_proc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;startArrow=block;" target="a_origen" value="1-2) Impide nuevas operaciones; el core origen confirma bloqueo&amp;nbsp;&lt;div&gt;completo (pendientes completadas o compensadas)&lt;/div&gt;">
          <mxGeometry relative="1" x="-0.0129" y="-22" as="geometry">
            <mxPoint x="12" y="-20" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a_e3" edge="1" parent="1" source="a_proc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;startArrow=block;" target="a_ownreg" value="3-4) Actualiza propietario y versión (operación durable); el registro confirma la escritura antes de continuar">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a_e5" edge="1" parent="1" source="a_proc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;" target="a_destino" value="5) Habilita escritura local (operación separada del paso 3, verificada contra el registro)">
          <mxGeometry relative="1" x="-0.0116" y="-40" as="geometry">
            <mxPoint x="40" y="-41" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a_e6" edge="1" parent="1" source="a_proc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;" target="a_eventbus" value="6) Publica evento de cambio de propietario">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="510.08" y="120" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a_e7" edge="1" parent="1" source="a_eventbus" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;" target="a_readmodel" value="7) Actualiza vista de lectura multicore">
          <mxGeometry relative="1" y="-40" as="geometry">
            <mxPoint x="-1" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a_legend" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#08427B;&quot;&gt;■&lt;/span&gt; Proceso operativo&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#2E6295;&quot;&gt;■&lt;/span&gt; Contenedor en alcance&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#6B6B6B;&quot;&gt;■&lt;/span&gt; Core (origen/destino)&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#B85450;&quot;&gt;■&lt;/span&gt; Ruta de contingencia" vertex="1">
          <mxGeometry height="40" width="900" x="60" y="850" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="c4-dynamic-pago-legado" name="C4 Dynamic - Pago con Fallback a Legado (ACL)">
    <mxGraphModel dx="1584" dy="2089" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="b_title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" value="Diagrama C4 Dynamic — Pago con fallback a legado vía ACL" vertex="1">
          <mxGeometry height="60" width="2560" x="20" y="-260" as="geometry" />
        </mxCell>
        <mxCell id="b_note" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#666666;whiteSpace=wrap;" value="Contexto: la orden ya fue enrutada por el API Gateway al Payment Hub (ver Nivel 2). Este diagrama detalla el caso en que la cuenta pertenece al core tradicional (legado)." vertex="1">
          <mxGeometry height="40" width="1400" x="900" y="-170" as="geometry" />
        </mxCell>
        <mxCell id="b_pic" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Payment Initiation Controller&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;" vertex="1">
          <mxGeometry height="120" width="260" x="20" as="geometry" />
        </mxCell>
        <mxCell id="b_idem" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Idempotency Guard&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;" vertex="1">
          <mxGeometry height="120" width="260" x="480" as="geometry" />
        </mxCell>
        <mxCell id="b_vco" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Validation &amp;amp; Compliance Orchestrator&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;" vertex="1">
          <mxGeometry height="120" width="260" x="940" as="geometry" />
        </mxCell>
        <mxCell id="b_ledger" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Ledger Adapter&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;" vertex="1">
