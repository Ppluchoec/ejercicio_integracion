  <diagram id="c4-component-paymenthub" name="C4 - Nivel 3 - Componentes Payment Hub">
    <mxGraphModel dx="1178" dy="1601" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title3" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" value="Diagrama C4 – Nivel 3: Componentes de Payment Hub&lt;br&gt;&lt;i&gt;Incluye dependencias externas del contenedor&lt;/i&gt;" vertex="1">
          <mxGeometry height="45" width="2345" x="20" y="-420" as="geometry" />
        </mxCell>
        <mxCell id="boundary3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=2;spacing=10;" value="Payment Hub  [Contenedor]" vertex="1">
          <mxGeometry height="1150" width="1450" x="20" y="-80" as="geometry" />
        </mxCell>
        <mxCell id="k_pic" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Payment Initiation Controller&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Recibe la orden desde el API Gateway y valida el esquema" vertex="1">
          <mxGeometry height="130" width="230" x="60" y="-10" as="geometry" />
        </mxCell>
        <mxCell id="k_idem" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Idempotency Guard&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Verifica la clave de idempotencia; si ya existe con estado en curso, rechaza la solicitud concurrente en vez de procesarla en paralelo" vertex="1">
          <mxGeometry height="130" width="230" x="370" y="-10" as="geometry" />
        </mxCell>
        <mxCell id="k_vco" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Validation &amp;amp; Compliance Orchestrator&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Coordina el esquema: llama riesgo, fraude y sanciones en paralelo" vertex="1">
          <mxGeometry height="130" width="250" x="590" y="200" as="geometry" />
        </mxCell>
        <mxCell id="k_ledger" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Ledger Adapter&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Reserva/debita/acredita en el core propietario vía su API, con clave de operación estable; ante timeout consulta estado antes de reintentar (nunca reintenta a ciegas)" vertex="1">
          <mxGeometry height="130" width="230" x="890" y="-22" as="geometry" />
        </mxCell>
        <mxCell id="k_pee" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Payment Execution Engine&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Ejecuta el esquema: aplica el resultado, confirma o compensa" vertex="1">
          <mxGeometry height="130" width="230" x="360" y="385" as="geometry" />
        </mxCell>
        <mxCell id="k_rail" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Rail Router&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Selecciona y enruta al riel de pago correspondiente" vertex="1">
          <mxGeometry height="130" width="250" x="720" y="470" as="geometry" />
        </mxCell>
        <mxCell id="k_idemstore" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=10;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Idempotency Store&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente: DB]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Tabla separada en el mismo instancia Oracle de Payment Hub. Persiste claves procesadas (TTL definido)" vertex="1">
          <mxGeometry height="150" width="230" x="60" y="640" as="geometry" />
        </mxCell>
        <mxCell id="k_paystore" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=10;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Payment Store&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente: DB]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Mismo instancia Oracle de Payment Hub: tabla de estado del esquema + tabla outbox, escritas juntas en una transacción" vertex="1">
          <mxGeometry height="150" width="280" x="340" y="640" as="geometry" />
        </mxCell>
        <mxCell id="k_outbox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Outbox Publisher&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Sondea (poll) la tabla outbox de forma asíncrona y publica al Event Bus, con reintentos" vertex="1">
          <mxGeometry height="150" width="250" x="720" y="640" as="geometry" />
        </mxCell>
