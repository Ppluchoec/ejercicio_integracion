          <mxGeometry height="90" width="260" x="1300" y="40" as="geometry" />
        </mxCell>
        <mxCell id="is_bff" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;dashed=1;" value="&lt;b&gt;BFF Canal Digital&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor]&lt;/i&gt;" vertex="1">
          <mxGeometry height="90" width="260" x="20" y="330" as="geometry" />
        </mxCell>
        <mxCell id="is_gw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;dashed=1;" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedor]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Cachea JWKS localmente (continuidad, 11.1)" vertex="1">
          <mxGeometry height="110" width="260" x="1300" y="330" as="geometry" />
        </mxCell>
        <mxCell id="is_idp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673A6;strokeColor=#76608A;fontColor=#FFFFFF;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Identity Provider&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente: Authorization Server]&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="440" x="570" y="620" as="geometry" />
        </mxCell>
        <mxCell id="is_mfa" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673A6;strokeColor=#76608A;fontColor=#FFFFFF;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;MFA Service&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;" vertex="1">
          <mxGeometry height="100" width="260" x="300" y="900" as="geometry" />
        </mxCell>
        <mxCell id="is_consent" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673A6;strokeColor=#76608A;fontColor=#FFFFFF;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Consent &amp;amp; Entitlement Service&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;" vertex="1">
          <mxGeometry height="100" width="300" x="1020" y="900" as="geometry" />
        </mxCell>
        <mxCell id="is_core" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;dashed=1;" value="&lt;b&gt;Core Bancario Digital / Payment Hub&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Contenedores]&lt;/i&gt;" vertex="1">
          <mxGeometry height="100" width="440" x="570" y="1160" as="geometry" />
        </mxCell>
        <mxCell id="is_note1" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=2;fontColor=#666666;whiteSpace=wrap;" value="Contexto: cubre el inicio de sesión de canal (izquierda/centro) y el flujo Open Finance con FAPI (derecha); ambos convergen en el Identity Provider y en la validación de token en cada llamada al API Gateway (11)." vertex="1">
          <mxGeometry height="40" width="1560" x="20" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="is_note2" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontStyle=2;fontColor=#666666;whiteSpace=wrap;" value="Contingencia (11.1): si el IAM está degradado, el Gateway no bloquea toda operación por igual — baja sensibilidad: acepta la última clave JWKS cacheada más allá de su vigencia normal; alta sensibilidad: bloquea hasta reconexión, mitigado por una lista de revocación local de vigencia corta." vertex="1">
          <mxGeometry height="55" width="1560" x="20" y="1370" as="geometry" />
        </mxCell>
        <mxCell id="is_e1" edge="1" parent="1" source="is_cliente" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;" target="is_bff" value="1) Inicia sesión (web/móvil)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="is_e2" edge="1" parent="1" source="is_bff" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;" target="is_idp" value="2,5) Redirige al login (Authorization Code + PKCE, OIDC); tras autenticar (y MFA si aplica) emite access token JWT (5–15 min) + refresh token">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="670.11" y="375" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="is_e3" edge="1" parent="1" source="is_idp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;" target="is_mfa" value="3-4) Step-up si la operación es de alta sensibilidad (11); MFA confirma segundo factor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="is_e4" edge="1" parent="1" source="is_bff" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;" target="is_gw" value="6) Llama con access token en cada solicitud">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="800.11" y="340.11" />
              <mxPoint x="800.11" y="360.11" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="is_e5" edge="1" parent="1" source="is_tpp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;" target="is_idp" value="9,11) Solicitud FAPI (mTLS + JWS firmado); tras validar el consentimiento, emite token restringido al alcance consentido">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="850.11" y="85" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="is_e6" edge="1" parent="1" source="is_idp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;" target="is_consent" value="10) Valida consentimiento (alcance, versión, vigencia)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="is_e7" edge="1" parent="1" source="is_tpp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;" target="is_gw" value="12) Llama con token de alcance limitado">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="is_e8" edge="1" parent="1" source="is_gw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;" target="is_core" value="7-8,13) Valida el token (JWKS cacheado, 11.1) y autoriza por scopes/roles o por el alcance del consentimiento; enruta">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1440.11" y="1210.11" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="is_legend" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#08427B;&quot;&gt;■&lt;/span&gt; Actor&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#9673A6;&quot;&gt;■&lt;/span&gt; Componente IAM&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#6B6B6B;&quot;&gt;■&lt;/span&gt; Contenedor referenciado" vertex="1">
          <mxGeometry height="30" width="1560" x="20" y="1440" as="geometry" />
        </mxCell>
