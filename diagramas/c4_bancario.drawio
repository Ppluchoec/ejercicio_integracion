  <diagram id="mVKUfjuhS19xGn9Wi_7D" name="C4 - Nivel 3 - Componentes Payment Hub">
    <mxGraphModel dx="2571" dy="1529" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="RNOovXjiGSu3f4s4odDM-1" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" value="Diagrama C4 – Nivel 3: Componentes de Payment Hub&lt;br&gt;&lt;i&gt;Incluye dependencias externas del contenedor&lt;/i&gt;" vertex="1">
          <mxGeometry height="45" width="2345" x="310" y="690" as="geometry" />
        </mxCell>
        <mxCell id="RNOovXjiGSu3f4s4odDM-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=2;spacing=10;" value="Payment Hub  [Contenedor&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;]&lt;/span&gt;" vertex="1">
          <mxGeometry height="1150" width="1450" x="310" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="RNOovXjiGSu3f4s4odDM-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Payment Initiation Controller&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Recibe la orden desde el API Gateway y valida el esquema" vertex="1">
          <mxGeometry height="130" width="230" x="350" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="RNOovXjiGSu3f4s4odDM-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Idempotency Guard&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Verifica la clave de idempotencia; si ya existe con estado en curso, rechaza la solicitud concurrente en vez de procesarla en paralelo" vertex="1">
          <mxGeometry height="130" width="230" x="660" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="RNOovXjiGSu3f4s4odDM-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Validation &amp;amp; Compliance Orchestrator&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Coordina el esquema: llama riesgo, fraude y sanciones en paralelo" vertex="1">
          <mxGeometry height="130" width="250" x="880" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="RNOovXjiGSu3f4s4odDM-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Ledger Adapter&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Reserva/debita/acredita en el core propietario vía su API, con clave de operación estable; ante timeout consulta estado antes de reintentar (nunca reintenta a ciegas)" vertex="1">
          <mxGeometry height="130" width="230" x="1180" y="1088" as="geometry" />
        </mxCell>
        <mxCell id="RNOovXjiGSu3f4s4odDM-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Payment Execution Engine&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Ejecuta el esquema: aplica el resultado, confirma o compensa" vertex="1">
          <mxGeometry height="130" width="230" x="650" y="1495" as="geometry" />
        </mxCell>
        <mxCell id="RNOovXjiGSu3f4s4odDM-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Rail Router&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Selecciona y enruta al riel de pago correspondiente" vertex="1">
          <mxGeometry height="130" width="250" x="1010" y="1580" as="geometry" />
        </mxCell>
        <mxCell id="RNOovXjiGSu3f4s4odDM-9" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=10;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Idempotency Store&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente: DB]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Tabla separada en el mismo instancia Oracle de Payment Hub. Persiste claves procesadas (TTL definido)" vertex="1">
          <mxGeometry height="150" width="230" x="350" y="1750" as="geometry" />
        </mxCell>
        <mxCell id="RNOovXjiGSu3f4s4odDM-10" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=10;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Payment Store&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente: DB]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Mismo instancia Oracle de Payment Hub: tabla de estado del esquema + tabla outbox, escritas juntas en una transacción" vertex="1">
          <mxGeometry height="150" width="280" x="630" y="1750" as="geometry" />
        </mxCell>
        <mxCell id="RNOovXjiGSu3f4s4odDM-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Outbox Publisher&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Sondea (poll) la tabla outbox de forma asíncrona y publica al Event Bus, con reintentos" vertex="1">
          <mxGeometry height="150" width="250" x="1010" y="1750" as="geometry" />
        </mxCell>
