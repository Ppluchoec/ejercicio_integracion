        <mxCell id="b_coretrad" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Core Bancario Tradicional&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema Externo]&lt;/i&gt;" vertex="1">
          <mxGeometry height="120" width="260" x="2320" as="geometry" />
        </mxCell>
        <mxCell id="b_idemstore" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Idempotency Store&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente: DB]&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="260" x="480" y="300" as="geometry" />
        </mxCell>
        <mxCell id="b_ownreg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;dashed=1;" value="&lt;b&gt;Registro de Propiedad de Cuentas&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container, ver 8.2]&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="260" x="1400" y="300" as="geometry" />
        </mxCell>
        <mxCell id="b_uncertain" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#666666;whiteSpace=wrap;" value="Resultado incierto (timeout / error de comunicación): el ACL no asume éxito ni fallo; marca la operación como pendiente de verificación y dispara conciliación mediante consulta o reintento idempotente con operationId (hallazgo E)." vertex="1">
          <mxGeometry height="90" width="320" x="1860" y="300" as="geometry" />
        </mxCell>
        <mxCell id="b_pee" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Payment Execution Engine&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;" vertex="1">
          <mxGeometry height="120" width="260" x="940" y="620" as="geometry" />
        </mxCell>
        <mxCell id="b_paystore" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Payment Store&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente: DB]&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="260" x="940" y="900" as="geometry" />
        </mxCell>
        <mxCell id="b_outbox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5B9BD5;fontColor=#1a1a1a;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Outbox Publisher&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Componente]&lt;/i&gt;" vertex="1">
          <mxGeometry height="120" width="260" x="1400" y="620" as="geometry" />
        </mxCell>
        <mxCell id="b_eventbus" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;dashed=1;" value="&lt;b&gt;Event Bus&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container, ver 8.2]&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="260" x="1860" y="620" as="geometry" />
        </mxCell>
        <mxCell id="b_e1" edge="1" parent="1" source="b_pic" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;" target="b_idem" value="1) Reenvía para verificación de idempotencia">
          <mxGeometry relative="1" y="50" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="b_e2" edge="1" parent="1" source="b_idem" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;" target="b_idemstore" value="2) Verifica idempotencyKey (lee/escribe la clave)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b_e3" edge="1" parent="1" source="b_idem" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;" target="b_vco" value="3) OK, sin duplicado — ejecuta el esquema&lt;div&gt;&amp;nbsp;(riesgo, fraude y sanciones en paralelo)&lt;/div&gt;">
          <mxGeometry relative="1" x="-0.1" y="40" as="geometry">
            <mxPoint x="-1" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="b_e4" edge="1" parent="1" source="b_vco" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;" target="b_ledger" value="4) Resultado de validación OK&lt;div&gt;&amp;nbsp;— reserva fondos&lt;/div&gt;">
          <mxGeometry relative="1" x="-0.1" y="10" as="geometry">
            <mxPoint x="-1" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="b_e5" edge="1" parent="1" source="b_ledger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;" target="b_ownreg" value="5) Consulta propietario, versión y estado">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b_e6" edge="1" parent="1" source="b_ledger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;" target="b_acl" value="6) Propietario = legado&amp;nbsp;&lt;div&gt;— invoca ACL con operationId&lt;/div&gt;">
          <mxGeometry relative="1" y="-30" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="b_e7" edge="1" parent="1" source="b_acl" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;" target="b_coretrad" value="7) Traduce y ejecuta; precondición: referencia de&amp;nbsp;&lt;div&gt;operación persistida y verificable en el legado (hallazgo E)&lt;/div&gt;">
          <mxGeometry relative="1" y="-70" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="b_e8" edge="1" parent="1" source="b_acl" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;dashed=1;strokeColor=#B85450;fontColor=#B85450;" target="b_ledger" value="8) Resultado incierto — concilia antes de confirmar (ver nota)">
          <mxGeometry relative="1" y="-50" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="1760" y="40" />
              <mxPoint x="1760" y="40" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="b_e9" edge="1" parent="1" source="b_ledger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;" target="b_pee" value="9) Confirma o compensa el movimiento">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1440" y="180" />
              <mxPoint x="1150" y="180" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="b_e10" edge="1" parent="1" source="b_pee" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;" target="b_paystore" value="10) Escribe estado + outbox (misma transacción)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b_e11" edge="1" parent="1" source="b_outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;" target="b_paystore" value="11) Sondea outbox pendiente (polling asíncrono)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1530" y="790.06" />
              <mxPoint x="1130" y="790.06" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="b_e12" edge="1" parent="1" source="b_outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=9;align=center;" target="b_eventbus" value="12) Publica evento">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b_legend" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5B9BD5;&quot;&gt;■&lt;/span&gt; Componente de Payment Hub&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#6B6B6B;&quot;&gt;■&lt;/span&gt; Sistema externo / referencia&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#B85450;&quot;&gt;■&lt;/span&gt; Ruta de contingencia (resultado incierto)" vertex="1">
          <mxGeometry height="40" width="1200" x="20" y="1080" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="cloud-azure-hadr" name="Cloud - Arquitectura Azure (HA-DR)">
    <mxGraphModel dx="1584" dy="2389" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="z_title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" value="Diagrama de Arquitectura en la Nube: Microsoft Azure" vertex="1">
          <mxGeometry height="70" width="2700" x="20" y="-300" as="geometry" />
        </mxCell>
        <mxCell id="z_note" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#666666;whiteSpace=wrap;" value="Regiones elegidas por disponibilidad confirmada de Oracle Database@Azure en Sudamérica: Brazil South (primaria, zonas de disponibilidad 2 y 3) y Brazil Southeast (secundaria/DR). La residencia de datos fuera de Ecuador debe validarse contra la LOPDP (12.1) antes de una decisión final de hosting." vertex="1">
          <mxGeometry height="70" width="1550" x="620" y="-210" as="geometry" />
        </mxCell>
        <mxCell id="z_cliente" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052744;fontColor=#FFFFFF;fontSize=12;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Cliente&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Actor]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Web, móvil o tercero autorizado (Open Finance)" vertex="1">
          <mxGeometry height="130" width="240" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="z_fd" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#005A9E;fontColor=#FFFFFF;fontSize=12;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Azure Front Door + WAF&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Azure: global]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Entrada global, TLS, protección DDoS/WAF y failover L7 de tráfico entre regiones" vertex="1">
          <mxGeometry height="140" width="340" x="900" y="40" as="geometry" />
        </mxCell>
        <mxCell id="z_region1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F2FB;strokeColor=#0078D4;dashed=1;verticalAlign=top;align=left;fontSize=14;fontStyle=1;spacing=10;" value="Región Primaria: Brazil South (zone-redundant, AZ2 + AZ3)" vertex="1">
          <mxGeometry height="780" width="1620" x="20" y="280" as="geometry" />
        </mxCell>
        <mxCell id="z_apim1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#005A9E;fontColor=#FFFFFF;fontSize=12;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Azure API Management&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Azure: entrada]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Equivale al API Gateway del Nivel 2: enrutamiento, throttling, validación de esquema" vertex="1">
          <mxGeometry height="150" width="310" x="70" y="360" as="geometry" />
        </mxCell>
        <mxCell id="z_iam_ref" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Plataforma IAM&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema Externo, ver Nivel 2]&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="260" x="480" y="420" as="geometry" />
        </mxCell>
        <mxCell id="z_kv1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#005A9E;fontColor=#FFFFFF;fontSize=12;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Azure Key Vault&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Azure: secretos]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Certificados TLS, claves y secretos vía Private Endpoint. Redundancia geográfica nativa del servicio: sin paso de DR adicional para los secretos" vertex="1">
          <mxGeometry height="160" width="300" x="760" y="360" as="geometry" />
        </mxCell>
        <mxCell id="z_aks1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#005A9E;fontColor=#FFFFFF;fontSize=12;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Azure Kubernetes Service (AKS)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Azure: cómputo, zone-redundant]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Node pools separados por contenedor: BFF Canal Digital, Core Bancario Digital, Payment Hub (equivalen al Nivel 2). Margen N+1 por zona" vertex="1">
          <mxGeometry height="190" width="430" x="70" y="570" as="geometry" />
        </mxCell>
        <mxCell id="z_kafka1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#005A9E;fontColor=#FFFFFF;fontSize=12;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Apache Kafka&lt;/b&gt;&lt;br&gt;&lt;i&gt;[AKS StatefulSet, zone-redundant]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Event Bus (9.1); 3 réplicas mínimo, una por zona; acks=all, min.insync.replicas≥2" vertex="1">
          <mxGeometry height="170" width="290" x="560" y="570" as="geometry" />
        </mxCell>
        <mxCell id="z_oracle1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#005A9E;fontColor=#FFFFFF;fontSize=12;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Oracle Database@Azure&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Azure: datos]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Core Bancario Digital y Payment Store de Payment Hub, en el mismo clúster. Sincronía intra-región (Data Guard SYNC, AZ2/AZ3, Fast-Start Failover). Cross-región: Core Digital asíncrono, Payment Store síncrono (aislado, ver flechas verde/roja)" vertex="1">
          <mxGeometry height="220" width="340" x="70" y="800" as="geometry" />
        </mxCell>
        <mxCell id="z_redis1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#005A9E;fontColor=#FFFFFF;fontSize=12;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Azure Cache for Redis&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Azure: datos, zone-redundant]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Registro de Propiedad de Cuentas (KV replicado, versionado)" vertex="1">
          <mxGeometry height="160" width="300" x="460" y="900" as="geometry" />
        </mxCell>
        <mxCell id="z_region2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F2FB;strokeColor=#0078D4;dashed=1;verticalAlign=top;align=left;fontSize=14;fontStyle=1;spacing=10;" value="Región Secundaria (DR): Brazil Southeast, standby cálido" vertex="1">
          <mxGeometry height="830" width="940" x="1720" y="280" as="geometry" />
        </mxCell>
        <mxCell id="z_apim2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7FB8E6;strokeColor=#005A9E;fontColor=#0a2a40;fontSize=12;arcSize=8;align=center;verticalAlign=middle;spacing=6;dashed=1;" value="&lt;b&gt;Azure API Management&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Azure: standby]&lt;/i&gt;" vertex="1">
          <mxGeometry height="120" width="290" x="1770" y="360" as="geometry" />
        </mxCell>
        <mxCell id="z_aks2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7FB8E6;strokeColor=#005A9E;fontColor=#0a2a40;fontSize=12;arcSize=8;align=center;verticalAlign=middle;spacing=6;dashed=1;" value="&lt;b&gt;AKS&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Azure: standby, capacidad reducida]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Mismos node pools, escalados a mínimo hasta una conmutación" vertex="1">
          <mxGeometry height="150" width="290" x="2100" y="360" as="geometry" />
        </mxCell>
        <mxCell id="z_oracle2_pay" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#1B5E20;fontColor=#0a2a40;fontSize=12;arcSize=8;align=center;verticalAlign=middle;spacing=6;dashed=1;" value="&lt;b&gt;Oracle Database@Azure&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Azure: standby, síncrono]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Payment Store: réplica síncrona confirmada (RPO 0)" vertex="1">
          <mxGeometry height="140" width="290" x="1770" y="530" as="geometry" />
        </mxCell>
        <mxCell id="z_oracle2_core" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7FB8E6;strokeColor=#005A9E;fontColor=#0a2a40;fontSize=12;arcSize=8;align=center;verticalAlign=middle;spacing=6;dashed=1;" value="&lt;b&gt;Oracle Database@Azure&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Azure: standby, asíncrono]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Core Bancario Digital: réplica asíncrona (apply lag &amp;gt; 0)" vertex="1">
          <mxGeometry height="140" width="290" x="1770" y="700" as="geometry" />
        </mxCell>
        <mxCell id="z_redis2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7FB8E6;strokeColor=#005A9E;fontColor=#0a2a40;fontSize=12;arcSize=8;align=center;verticalAlign=middle;spacing=6;dashed=1;" value="&lt;b&gt;Azure Cache for Redis&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Azure: standby]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Geo-réplica asíncrona (geo-replication)" vertex="1">
          <mxGeometry height="150" width="280" x="2100" y="550" as="geometry" />
        </mxCell>
        <mxCell id="z_kafka2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7FB8E6;strokeColor=#005A9E;fontColor=#0a2a40;fontSize=12;arcSize=8;align=center;verticalAlign=middle;spacing=6;dashed=1;" value="&lt;b&gt;Apache Kafka&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Azure: clúster nuevo, vacío]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Sin mirroring activo; se reconstruye por categoría de evento tras la promoción (8.5)" vertex="1">
          <mxGeometry height="150" width="260" x="2400" y="550" as="geometry" />
        </mxCell>
        <mxCell id="z_dr_note" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#666666;whiteSpace=wrap;" value="Kafka no tiene réplica multi-región activa: el clúster secundario se levanta vacío.&lt;br&gt;La recuperación es por categoría de evento (pagos, CDC, interacción, vistas derivadas),&lt;br&gt;no por reproducción de historial (8.5). El RPO de Core Digital y Redis depende del&lt;br&gt;retraso de la replicación asíncrona y se valida con simulacros (15.3); el Payment Store&lt;br&gt;es la única excepción síncrona (flecha verde)." vertex="1">
          <mxGeometry height="130" width="900" x="1770" y="940" as="geometry" />
        </mxCell>
        <mxCell id="z_gw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#005A9E;fontColor=#FFFFFF;fontSize=12;arcSize=8;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;Azure ExpressRoute / VPN Gateway&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Azure: conectividad híbrida]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Debe alcanzar el legado desde ambas regiones (Global Reach o circuito adicional desde la región secundaria)" vertex="1">
          <mxGeometry height="130" width="360" x="420" y="1120" as="geometry" />
        </mxCell>
